{
 "hooks": {
  "PreToolUse": [
   {"matcher": "Bash", "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.js"], "timeout": 120}]}
  ],
  "Stop": [
   {"hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-check.js"], "timeout": 120}]}
  ],
  "SessionStart": [
   {"matcher": "startup|compact", "hooks": [{"type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ctx.js"], "timeout": 20}]}
  ]
 }
}
